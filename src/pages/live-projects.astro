---
import "../styles/global.css";
import LiveProjectsSection from "../components/LiveProjectsSection.astro";

const pageTitle = "Live Projects | thefakezach";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="Real businesses I'm operating, in real time. Live metrics, current focus, and recent activity." />
    <meta name="theme-color" content="#0000EE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-paper text-ink font-sans min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

      <a
        href="/"
        class="inline-flex items-center gap-2 text-accent hover:text-accent text-sm font-semibold no-underline hover:no-underline mb-8"
      >
        ← Home
      </a>

      <header
        class="bg-paper2 backdrop-blur border border-ink rounded-2xl p-8 sm:p-10 mb-8 text-center"
      >
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 text-ink"
        >
          Live Projects
        </h1>
        <p class="text-muted text-lg sm:text-xl font-medium mb-4">
          Businesses I'm running, in real time
        </p>
        <p class="text-muted max-w-2xl mx-auto">
          Each card is a real operating business. Metrics here are placeholders today — the data shape underneath each one declares where the live value will be read from once wired up.
        </p>
      </header>

      <LiveProjectsSection />

      <footer class="mt-12 pt-8 border-t border-ink text-center text-xs text-muted">
        © {new Date().getFullYear()} Zachary Lewis
      </footer>

    </div>
  </body>
</html>
