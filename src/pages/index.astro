---
import BrandLayout from "../layouts/BrandLayout.astro";

const services = [
  {
    title: "Systems Design & Build",
    desc: "I design and ship agent systems that run real operations — voice agents, automations, multi-agent platforms — each one bounded by a budget and a permission scope you set. Done-with-you or done-for-you.",
    href: "/services#build",
    tag: "Build",
  },
  {
    title: "Workshops & Training",
    desc: "Hands-on sessions that take your team from experimenting to shipping. Half-day to multi-day, built around your actual workflows.",
    href: "/services#training",
    tag: "Train",
  },
];

// Featured projects, framed as "originals" (logo shown when available; text mark otherwise).
const featuredProjects = [
  { ep: "EP.01", category: "PLATFORM", name: "AgentlandOS", tagline: "Agents that run small-business operations", logo: "/project-logos/agentland-logo.png", cover: true, href: "/work#agentlandos" },
  { ep: "EP.02", category: "CIVIC TECH", name: "Yard Line", tagline: "Support for families on the outside", logo: null, href: "/work#yard-line" },
  { ep: "EP.03", category: "QUANT", name: "Trading System", tagline: "Agent-based market signals", logo: "/project-logos/trading-logo.png", cover: true, href: "/work#fake-money" },
];

// Scrolling marquee strip (broadcast/editorial motif)
const marqueeItems = [
  "AGENT PLATFORMS", "VOICE AGENTS", "MARKETPLACES", "DATA PIPELINES",
  "REAL-TIME SYSTEMS", "FREE TOOLS", "BUILT IN DETROIT", "25M+ VIEWS",
];

const testimonials = [
  {
    quote:
      "Zach doesn’t just talk about AI — he builds the thing and shows you the dashboard. We went from idea to a working agent in days.",
    name: "Operations Lead",
    org: "Local Services Business",
  },
  {
    quote:
      "The most practical AI session our team has had. No buzzwords, just systems we actually use now.",
    name: "Founder",
    org: "Detroit Startup",
  },
  {
    quote:
      "He gets that AI is only useful if it runs without you babysitting it. That mindset changed how we operate.",
    name: "Small Business Owner",
    org: "Service Company",
  },
];
---

<BrandLayout active="home">
  <!-- HERO / SHOWREEL -->
  <section class="border-b border-ink">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20 grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink/60 mb-6">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          Zachary Lewis — a one-person media co.
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-[3.4rem] font-semibold tracking-tight text-ink leading-[1.04]">
          I build and design systems that
          <span class="text-accent"> change the way you work.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-ink/80 leading-relaxed max-w-xl">
          Agent platforms, marketplaces, data pipelines, and voice systems — running in production
          for real businesses in Detroit and beyond. I design them, build them, and keep them running.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-2.5">
          <a href="/work" class="px-6 py-3.5 bg-ink text-white border border-ink font-medium text-center hover:bg-accent hover:border-accent transition-colors">
            Watch the Work
          </a>
          <a href="/contact" class="px-6 py-3.5 border border-ink text-ink font-medium text-center hover:bg-paper2 transition-colors">
            Work With Me
          </a>
        </div>
      </div>

      <!-- Showreel player (drop a video in below) -->
      <figure class="border border-ink bg-paper2">
        <!-- top bar -->
        <div class="flex items-center justify-between px-3 py-2.5 border-b border-ink font-mono text-[10px] uppercase tracking-widest text-muted">
          <span>Reel 2026</span>
          <span>16:9</span>
        </div>
        <div class="relative aspect-video w-full overflow-hidden group">
          <!-- Replace this placeholder with a <video> or <img>:
               <video src="/hero.mp4" autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover"></video> -->
          <!-- play button -->
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="w-14 h-14 rounded-full border border-ink text-ink flex items-center justify-center text-sm pl-0.5 group-hover:bg-ink group-hover:text-white transition-colors">▶</span>
          </div>
        </div>
        <!-- scrubber -->
        <figcaption class="flex items-center gap-3 px-3 py-2.5 border-t border-ink font-mono text-[10px] text-muted">
          <span>00:00</span>
          <span class="flex-1 h-0.5 bg-hair relative overflow-hidden"><span class="absolute inset-y-0 left-0 w-1/4 bg-accent"></span></span>
          <span>02:14</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee bg-paper text-ink border-b border-ink py-3">
    <div class="marquee__track font-mono text-[11px] font-medium uppercase tracking-widest">
      {[...marqueeItems, ...marqueeItems].map((m) => (
        <span class="mx-5 inline-flex items-center gap-5"><span>{m}</span><span class="text-muted">—</span></span>
      ))}
    </div>
  </div>

  <!-- ORIGINALS -->
  <section class="border-b border-ink bg-paper">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="flex items-end justify-between mb-6">
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-widest text-muted">Selected work</h2>
        <a href="/work" class="font-mono text-[11px] uppercase tracking-widest text-accent hover:text-accent-dark">All work →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
      {featuredProjects.map((p) => (
        <a href={p.href} class="group no-underline border border-ink bg-paper hover:bg-paper2 transition-colors">
          <!-- thumbnail / channel-bug -->
          <div class="relative aspect-video w-full overflow-hidden border-b border-ink bg-paper2 flex items-center justify-center">
            {p.logo ? (
              <img src={p.logo} alt={`${p.name}`} class={p.cover ? "absolute inset-0 w-full h-full object-cover" : "max-h-20 max-w-[70%] object-contain"} loading="lazy" />
            ) : (
              <span class="text-xl font-medium tracking-tight text-ink">{p.name}</span>
            )}
            <span class="absolute top-2.5 left-3 font-mono text-[10px] uppercase tracking-widest text-muted">{p.ep}</span>
          </div>
          <div class="px-4 py-4">
            <span class="font-mono text-[10px] uppercase tracking-widest text-muted">{p.category}</span>
            <h3 class="mt-1.5 text-lg font-medium text-ink">{p.name}</h3>
            <p class="mt-1 text-sm text-muted">{p.tagline}</p>
          </div>
        </a>
      ))}
      </div>
    </div>
  </section>

  <!-- BIO -->
  <section class="border-y border-ink bg-paper">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 grid md:grid-cols-5 gap-12 items-start">
      <div class="md:col-span-2">
        <div class="aspect-square w-full max-w-sm overflow-hidden border border-ink bg-paper2">
          <img src="/profile-photo.jpg" alt="Zachary Lewis" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      <div class="md:col-span-3">
        <p class="font-mono text-[11px] font-medium uppercase tracking-widest text-muted mb-5">Background</p>
        <h2 class="text-3xl md:text-4xl font-semibold text-ink mb-5">From video to production systems</h2>
        <p class="text-muted leading-relaxed mb-4">
          I spent years building a video production business, growing an audience of 100K+ followers and 25M+ views
          while building the websites and automations my clients ran on. In 2024 I turned that toward agent systems full-time.
          Since then: an agent platform that runs my own companies, a trading workspace, a laundry marketplace, a
          self-enriching map of Detroit's small businesses, and a support platform for families of incarcerated people.
        </p>
        <p class="text-muted leading-relaxed mb-7">
          I learn by building the thing. When I work with you, what you get is software you can open in a browser.
        </p>
        <a href="/about" class="inline-block px-5 py-3 border border-ink text-ink font-medium hover:bg-paper2 transition-colors">
          More about me
        </a>
      </div>
    </div>
  </section>

  <!-- HOW I CAN HELP + PROOF / TOOLS -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    <div class="max-w-2xl mb-10">
      <p class="font-mono text-[11px] font-medium uppercase tracking-widest text-muted mb-5">How I can help</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-ink">Two ways to put this to work in your business.</h2>
    </div>
    <div class="grid md:grid-cols-2 border-t border-ink">
      {services.map((s, i) => (
        <a href={s.href} class="group block no-underline border-b border-ink md:odd:border-r py-8 md:pr-8 md:odd:pl-0 md:even:pl-8">
          <span class="font-mono text-[10px] uppercase tracking-widest text-muted">{`0${i + 1} / ${s.tag}`}</span>
          <h3 class="text-xl font-medium text-ink mb-2 mt-3 group-hover:text-accent transition-colors">{s.title}</h3>
          <p class="text-muted text-sm leading-relaxed max-w-[46ch]">{s.desc}</p>
          <span class="mt-5 inline-block text-sm text-accent">Learn more →</span>
        </a>
      ))}

      <a href="/work" class="group block no-underline border-b border-ink md:border-r py-8 md:pr-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-muted">03 / Proof</span>
        <h3 class="text-xl font-medium text-ink mb-2 mt-3 group-hover:text-accent transition-colors">Real systems I've shipped</h3>
        <p class="text-muted text-sm leading-relaxed max-w-[46ch]">
          AgentlandOS, an agent-based trading platform, a laundry marketplace, a city business map — software that handles real work, not slideware.
        </p>
        <span class="mt-5 inline-block text-sm text-accent">See my work →</span>
      </a>
      <a href="/tools" class="group block no-underline border-b border-ink py-8 md:pl-8">
        <span class="font-mono text-[10px] uppercase tracking-widest text-muted">04 / Free, no signup</span>
        <h3 class="text-xl font-medium text-ink mb-2 mt-3 group-hover:text-accent transition-colors">Try my tools</h3>
        <p class="text-muted text-sm leading-relaxed max-w-[46ch]">
          Open-source utilities and free tools — including the <strong class="text-ink font-medium">USER.md generator</strong> that gives any AI assistant your full context in one file.
        </p>
        <span class="mt-5 inline-block text-sm text-accent">Browse free tools →</span>
      </a>
    </div>
  </section>

  {/* TESTIMONIALS — hidden for now, kept for later
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-28 pt-0">
    <h2 class="text-3xl md:text-4xl font-bold text-ink text-center mb-12">What people say</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="rounded-2xl border border-ink bg-white p-7">
          <div class="text-hair text-3xl leading-none mb-3">&ldquo;</div>
          <blockquote class="text-ink/80 text-sm leading-relaxed">{t.quote}</blockquote>
          <figcaption class="mt-5 pt-5 border-t border-ink">
            <div class="font-semibold text-ink text-sm">{t.name}</div>
            <div class="text-ink/50 text-xs">{t.org}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  */}

  {/* FAKE MONEY — saved, hidden for now
  <section class="border-t border-ink">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <div class="rounded-3xl bg-paper2 border border-ink p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-muted mb-3">Fake Money</span>
            <h2 class="text-2xl md:text-3xl font-bold text-ink mb-3">Follow the build, in public</h2>
            <p class="text-ink/80 leading-relaxed mb-5">
              <strong>Fake Money</strong> — a trading platform where the scanners run on a schedule and nothing ever auto-fires.
            </p>
            <ul class="space-y-2 text-sm text-ink/80 mb-6">
              <li class="flex gap-2"><span>🧠</span> Agents read companies and live charts to call the signals</li>
              <li class="flex gap-2"><span>🛡️</span> Every order clears a risk pipeline — no entry without a stop</li>
              <li class="flex gap-2"><span>🎚️</span> Autonomous execution off by default — you stay in control</li>
            </ul>
            <p class="text-xs font-semibold uppercase tracking-wider text-ink/50 mb-2">What you'll need to run it</p>
            <ul class="space-y-2 text-sm text-ink/80">
              <li class="flex gap-2"><span class="text-accent">→</span> A <span class="font-medium">tastytrade</span> brokerage account</li>
              <li class="flex gap-2"><span class="text-accent">→</span> Your own LLM API keys — Gemini's free tier works,
                <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="text-accent font-medium hover:text-accent-dark">grab keys from the Gemini dashboard ↗</a>
              </li>
            </ul>
          </div>
          <div>
            <form name="journey" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you" class="space-y-3">
              <input type="hidden" name="form-name" value="journey" />
              <input type="text" name="name" placeholder="Your name" required class="w-full px-4 py-3 rounded-xl bg-white border border-ink text-ink placeholder-ink/40 focus:outline-none focus:border-accent" />
              <input type="email" name="email" placeholder="you@email.com" required class="w-full px-4 py-3 rounded-xl bg-white border border-ink text-ink placeholder-ink/40 focus:outline-none focus:border-accent" />
              <button type="submit" class="w-full px-6 py-3.5 rounded-xl bg-ink text-white border border-ink font-medium hover:bg-accent hover:border-accent transition-opacity">Follow the journey</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- FEATURED CAROUSEL -->
  <section class="border-t border-ink">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-24">
      <div class="flex items-end justify-between mb-6">
        <h2 class="font-mono text-[11px] font-medium uppercase tracking-widest text-muted">Featured</h2>
        <div class="flex gap-2">
          <button id="promo-prev" aria-label="Previous" class="w-10 h-10 border border-ink text-ink flex items-center justify-center hover:bg-paper2 transition-colors">←</button>
          <button id="promo-next" aria-label="Next" class="w-10 h-10 border border-ink text-ink flex items-center justify-center hover:bg-paper2 transition-colors">→</button>
        </div>
      </div>

      <div id="promo-track" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <!-- Slide 1: USER.md -->
        <a href="/tools/user-md" class="snap-start shrink-0 w-full no-underline">
          <div class="border border-ink overflow-hidden bg-paper2">
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-ink font-mono text-[10px] md:text-[11px] uppercase tracking-widest">
              <span class="text-accent">USER.md · Free tool</span>
              <span class="text-ink/50">No signup · Build yours →</span>
            </div>
            <div class="aspect-[4/3] md:aspect-[3/2] w-full flex items-center justify-center overflow-hidden">
              <img src="/user-md-cta.png" alt="USER.md — one file that gives any AI your full context" class="w-full h-full object-contain" loading="lazy" />
            </div>
          </div>
        </a>

        <!-- Slide 2: Agentland (custom card) -->
        <a href="https://agentlandos.com" target="_blank" rel="noopener noreferrer" class="snap-start shrink-0 w-full no-underline">
          <div class="border border-ink overflow-hidden bg-ink">
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/15 font-mono text-[10px] md:text-[11px] uppercase tracking-widest">
              <span class="text-white">AgentlandOS · Platform</span>
              <span class="text-white/50">agentlandos.com ↗</span>
            </div>

            <div class="relative aspect-[4/3] md:aspect-[3/2] w-full overflow-hidden p-6 md:p-10 flex flex-col items-start justify-center text-left">
              <!-- hairline grid -->
              <div class="absolute inset-0 opacity-[0.10]" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;"></div>

              <!-- giant wordmark + super-sized tagline -->
              <h3 class="relative font-semibold text-white tracking-[-0.04em] leading-[0.85]" style="font-size:clamp(3rem,15vw,10rem);">Agentland</h3>
              <p class="relative mt-3 md:mt-5 font-medium text-white/70 tracking-[-0.03em] leading-[0.95]" style="font-size:clamp(1.75rem,8vw,5rem);">Agents that operate your business</p>
              <span class="relative mt-6 md:mt-8 inline-flex items-center gap-2 px-6 py-3 bg-ink text-white font-medium text-sm hover:bg-accent">
                Visit AgentlandOS →
              </span>
            </div>
          </div>
        </a>
      </div>

      <!-- dots -->
      <div class="flex justify-center gap-2 mt-5">
        <button data-promo-dot aria-label="Go to slide 1" class="w-2.5 h-2.5 rounded-full bg-ink transition-colors"></button>
        <button data-promo-dot aria-label="Go to slide 2" class="w-2.5 h-2.5 rounded-full bg-ink/25 transition-colors"></button>
      </div>
    </div>
  </section>

  <script>
    const track = document.getElementById("promo-track");
    if (track) {
      const dots = Array.from(document.querySelectorAll("[data-promo-dot]"));
      const go = (i) => track.scrollTo({ left: track.clientWidth * i, behavior: "smooth" });
      document.getElementById("promo-prev")?.addEventListener("click", () =>
        track.scrollBy({ left: -track.clientWidth, behavior: "smooth" })
      );
      document.getElementById("promo-next")?.addEventListener("click", () =>
        track.scrollBy({ left: track.clientWidth, behavior: "smooth" })
      );
      dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
      track.addEventListener("scroll", () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((d, k) => {
          d.classList.toggle("bg-ink", k === i);
          d.classList.toggle("bg-ink/25", k !== i);
        });
      });
    }
  </script>

  {/* FINAL CTA — hidden for now, kept for later
  <section class="border-t border-ink bg-paper2">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4">Ready to put this to work?</h2>
      <p class="text-ink/60 text-lg mb-8">Tell me what you're trying to build or automate. I'll tell you the fastest path to a working system.</p>
      <a href="/contact" class="inline-block px-8 py-4 rounded-xl bg-ink text-white border border-ink font-medium hover:bg-accent hover:border-accent text-lg hover:opacity-90 transition-opacity">
        Start the conversation
      </a>
    </div>
  </section>
  */}
</BrandLayout>
