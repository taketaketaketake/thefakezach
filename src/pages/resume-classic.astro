---
import "../styles/global.css";

const pageTitle = "Resume | Zachary Lewis";

const zachary = {
  name: "Zachary Lewis",
  title: "Agentic Systems Engineer",
  email: "Zach@TakeDetroit.com",
  location: "Detroit, MI",
  website: "thefakezach.com",
  github: "github.com/taketaketaketake"
};

const summary = "Full-stack engineer who ships production systems end-to-end — architecture, implementation, deployment, and production ownership. Nine years building software for paying clients, the last two focused on AI systems: a multi-tenant agent platform (11 microservices, ~228K LOC), a live trading-research platform with a four-ledger LLM evaluation harness, and a family-office database migration reconciled to the cent against production data. Before software, I built a Detroit media brand to 100,000+ followers and 25 million video views. Deep in TypeScript and Python, with production experience in LLM orchestration, multi-agent systems, and durable workflows.";

const education = {
  school: "Kutztown University of Pennsylvania",
  degree: "B.S. Psychology",
  graduation: "2008"
};

const experience = [
  {
    company: "thefakezach.com",
    role: "Agentic Engineer + Entrepreneur",
    period: "2024 – Present",
    location: "Detroit, MI",
    bullets: [
      { bold: "Product Lifecycle Management", rest: " including voice AI agents handling live phone calls with sub-500ms latency, multi-agent observability platforms, and real-time systems." },
      { bold: "Agentic Engineering", rest: " authoring an open telephony standard extending Google's A2A protocol with phone and SMS capabilities; published reference server with JSON-RPC implementation." },
      { bold: "Harness Engineering", rest: " with orchestration, tool invocation, human-in-the-loop workflows, telemetry, and multi-tenant auth across 15+ service modules." },
      { bold: "Observability and Evals", rest: " for scoring agent quality across runs with trace ingestion from Langfuse, LangSmith, and OpenTelemetry." },
      { label: "Technologies", rest: "TypeScript, Node.js, Bun, Python, FastAPI, React, PostgreSQL, Redis, Telnyx, Gemini, Claude SDK, WebSocket, Docker, AWS" }
    ]
  },
  {
    company: "Take Detroit / Take Media",
    role: "Technical Director",
    period: "2015 – Present",
    location: "Detroit, MI",
    bullets: [
      { bold: "Social Media Management", rest: " across social platforms, growing an online brand to 100,000+ followers and generating 25+ million video views through original content." },
      { bold: "Online Marketing", rest: " establishing Detroit's go-to city guide and lifestyle brand through consistent publishing, livestreams, and editorial video." },
      { bold: "Live Broadcast and Video Production", rest: " for clients across food, sports, entertainment, and small business verticals." },
      { label: "Technologies", rest: "Adobe Premiere, OBS, vMix, Remotion, Three.js, Mapbox, Shopify" }
    ]
  },
];

const projects = [
  {
    title: "AgentlandOS",
    link: "agentlandos.com",
    bullets: [
      "Microservices architecture with 15+ service modules spanning orchestration, planning, and execution layers",
      "Agent routing, tool invocation, and human-in-the-loop workflows with telemetry, billing, and multi-tenant auth"
    ]
  },
  {
    title: "Agentland Docs",
    link: "docs.agentlandos.com",
    bullets: [
      "Documentation site covering the AgentlandOS platform, agent APIs, and integration guides",
      "Structured reference for developers building on the multi-agent runtime"
    ]
  },
  {
    title: "AgentLand Observability",
    link: "github.com/thefakezach",
    bullets: [
      "Real-time observability dashboard for Claude Code and Gemini CLI agent sessions with live event streaming",
      "LLM-powered evaluation system scoring agent quality across runs with session replay and transcript viewing",
      "Trace sharing, forking, and diffing across teams with version-controlled prompt pipelines",
      "Ingestion from Langfuse, LangSmith, OpenTelemetry, and direct API with automated eval suites"
    ]
  },
  {
    title: "A2A Telephony Protocol",
    link: "github.com/taketaketaketake/telephony-protocol",
    bullets: [
      "Authored open standard extending Google's A2A protocol with telephony capabilities for AI agents",
      "Reference server with conformant JSON-RPC implementation — any A2A-compliant agent can make phone calls and send texts"
    ]
  },
  {
    title: "Cosmic Crew",
    link: "cosmiccrew.club",
    bullets: [
      "Interactive 3D educational game with rocket navigation, star fields, and warp effects built in Three.js",
      "WebGL rendering with raycasting for interaction and multiple game modes including rocket explorer and space shooter"
    ]
  },
  {
    title: "On The Floor",
    link: "onthefloor.app",
    bullets: [
      "Full-stack patient care platform: React Native mobile app + Express API + PostgreSQL with Socket.io chat rooms",
      "Magic Link + OAuth auth, structured care reviews with scored signals for in-hospital patient expression"
    ]
  },
];

const skills = {
  languages: "TypeScript, JavaScript, Python, SQL",
  frontend: "React, React Native, Astro, Expo, Tailwind CSS, Vite, Three.js",
  backend: "Node.js, Bun, Express, FastAPI, Prisma, Socket.io, BullMQ, Microservices, REST APIs",
  ai: "Telnyx AI, Deepgram, Gemini, Claude SDK, LangChain, LLM Evaluation, Multi-Agent Systems, A2A Protocol",
  data: "PostgreSQL, SQLite, Redis, Supabase",
  infra: "AWS, GCP, Docker, Railway, Netlify, GitHub Actions, Sentry, CI/CD",
  integrations: "Stripe, Twilio, Resend, Shopify, Mapbox, Google Places, Better Auth"
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="Zachary Lewis - Agentic Systems Engineer resume (classic format)." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-paper text-ink font-sans min-h-screen">
    <div class="resume-classic max-w-[850px] mx-auto px-4 sm:px-8 py-10 text-[14px] leading-relaxed">

      <!-- Name -->
      <h1 class="text-center text-3xl sm:text-4xl font-bold tracking-tight text-ink">{zachary.name}</h1>

      <!-- Contact Row -->
      <div class="text-center text-sm mt-3 mb-6 text-muted">
        <span class="text-muted">{zachary.title}</span>
        <span class="text-muted mx-2">|</span>
        <span>{zachary.location}</span>
        <span class="text-muted mx-2">|</span>
        <a href={`https://${zachary.website}`} class="text-accent hover:text-accent transition-colors">{zachary.website}</a>
        <span class="text-muted mx-2">|</span>
        <a href={`https://${zachary.github}`} class="text-accent hover:text-accent transition-colors">GitHub</a>
      </div>

      <!-- Summary -->
      <h2 class="text-muted text-sm font-semibold tracking-widest uppercase mt-8 mb-3 pb-1 border-b border-ink">Summary</h2>
      <p class="text-ink">{summary}</p>

      <!-- Education -->
      <h2 class="text-muted text-sm font-semibold tracking-widest uppercase mt-8 mb-3 pb-1 border-b border-ink">Education</h2>
      <div class="mt-2">
        <div class="flex justify-between items-baseline flex-wrap gap-x-2">
          <div>
            <span class="font-semibold text-ink">{education.school}</span>
            <span class="text-muted"> | {education.degree}</span>
          </div>
          <div class="text-right text-muted">
            <span class="font-semibold text-ink">Graduation:</span> {education.graduation}
          </div>
        </div>
      </div>

      <!-- Experience -->
      <h2 class="text-muted text-sm font-semibold tracking-widest uppercase mt-8 mb-3 pb-1 border-b border-ink">Experience</h2>
      {experience.map((job) => (
        <div class="mt-3">
          <div class="flex justify-between items-baseline flex-wrap gap-x-2">
            <span class="font-semibold text-ink">{job.company}</span>
            <span class="text-muted">{job.period}</span>
          </div>
          <div class="flex justify-between items-baseline flex-wrap gap-x-2">
            <span class="italic text-ink">{job.role}</span>
            <span class="italic text-muted">{job.location}</span>
          </div>
          <ul class="list-disc pl-5 mt-1.5 space-y-1 marker:text-muted">
            {job.bullets.map((b) => (
              <li class="text-ink">
                {b.label ? (
                  <span class="text-muted"><span class="italic">{b.label} used:</span> {b.rest}</span>
                ) : (
                  <span><span class="font-semibold text-ink">{b.bold}</span>{b.rest}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Projects -->
      <h2 class="text-muted text-sm font-semibold tracking-widest uppercase mt-8 mb-3 pb-1 border-b border-ink">Projects</h2>
      {projects.map((project) => (
        <div class="mt-3">
          <div class="flex justify-between items-baseline flex-wrap gap-x-2">
            <span class="font-semibold text-ink">{project.title}</span>
            {project.link.startsWith("(") ? (
              <span class="italic text-muted">{project.link}</span>
            ) : (
              <a href={`https://${project.link}`} target="_blank" rel="noopener noreferrer" class="italic text-accent hover:text-accent">{project.link}</a>
            )}
          </div>
          <ul class="list-disc pl-5 mt-1 space-y-1 marker:text-muted">
            {project.bullets.map((bullet) => (
              <li class="text-ink">{bullet}</li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Technical Skills -->
      <h2 class="text-muted text-sm font-semibold tracking-widest uppercase mt-8 mb-3 pb-1 border-b border-ink">Technical Skills</h2>
      <ul class="list-disc pl-5 mt-2 space-y-1 marker:text-muted">
        <li class="text-ink"><span class="font-semibold text-ink">Languages:</span> {skills.languages}</li>
        <li class="text-ink"><span class="font-semibold text-ink">Frontend:</span> {skills.frontend}</li>
        <li class="text-ink"><span class="font-semibold text-ink">Backend:</span> {skills.backend}</li>
        <li class="text-ink"><span class="font-semibold text-ink">AI & Agents:</span> {skills.ai}</li>
        <li class="text-ink"><span class="font-semibold text-ink">Databases:</span> {skills.data}</li>
        <li class="text-ink"><span class="font-semibold text-ink">Cloud & Infra:</span> {skills.infra}</li>
        <li class="text-ink"><span class="font-semibold text-ink">Integrations:</span> {skills.integrations}</li>
      </ul>

      <!-- Print Button -->
      <div class="mt-10 text-center print:hidden">
        <button
          onclick="window.print()"
          class="inline-flex items-center gap-2 bg-accent hover:bg-ink text-white font-medium hover:bg-accent px-6 py-3 rounded-full transition-colors"
        >
          <span>📄</span>
          Print / Save as PDF
        </button>
      </div>
    </div>

    <style>
      .resume-classic ul {
        list-style-type: disc;
        list-style-position: outside;
        padding-left: 1.5rem;
      }
      .resume-classic ul li {
        padding-left: 0.25rem;
      }
      .resume-classic ul li::marker {
        color: #6B6B6B;
      }
      .resume-classic a {
        text-decoration: none;
      }
      .resume-classic a:hover {
        text-decoration: underline;
      }

      @media print {
        @page {
          margin: 0.4in;
        }
        body {
          background: white !important;
          color: black !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .text-white,
        .text-ink,
        .text-ink,
        .text-muted,
        .text-muted {
          color: #222 !important;
        }
        .text-accent {
          color: #0000B8 !important;
        }
        .border-ink {
          border-color: #222 !important;
        }
        .text-muted {
          color: #999 !important;
        }
        button {
          display: none;
        }
      }
    </style>
  </body>
</html>
