---
import "../styles/global.css";

const { project } = Astro.props;

// Guard clause — skip rendering if no project is provided
if (!project) {
  return null;
}

// Use project data directly
const page = {
  title: project.title || "Untitled Project",
  emoji: project.emoji || "💡",
  year: project.year || "2024",
  summary: project.summary || "Project description not available.",
  spark: project.spark || "What inspired this project.",
  whatItDoes: project.whatItDoes || "What this project does.",
  tech: project.tech || ["Coming Soon"],
  status: project.status || "shipped",
  link: project.link && project.link !== "#" ? project.link : null,
  github: project.github && project.github !== "#" ? project.github : null,
};

const slug = project.title.toLowerCase().replace(/ /g, "-");

// Status badge styles
type Status = "shipped" | "in-progress" | "archived";

const statusStyles: Record<Status, string> = {
  shipped: "bg-ink/20 text-ink border-ink/30",
  "in-progress": "bg-hair/20 text-muted border-ink/30",
  archived: "bg-hair/20 text-muted border-ink/30",
};

const statusLabels: Record<Status, string> = {
  shipped: "Shipped",
  "in-progress": "In Progress",
  archived: "Archived",
};

const status = (page.status as Status) || "shipped";
---

<!-- Backdrop -->
<div
  id={`modal-${slug}`}
  class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50"
  aria-hidden="true"
>
  <!-- Modal Content -->
  <div
    class="bg-paper2 text-ink p-8 rounded-2xl max-w-4xl w-[90%] shadow-lg overflow-y-auto max-h-[90vh] animate-fadeIn"
  >
    <header class="flex justify-between items-start mb-8">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-5xl">{page.emoji}</span>
          <span class={`px-3 py-1 text-xs font-medium rounded-full border ${statusStyles[status]}`}>
            {statusLabels[status]}
          </span>
        </div>
        <h1 class="text-3xl font-extrabold text-ink mb-2">{page.title}</h1>
        <p class="text-muted">{page.summary}</p>
        <p class="text-xs text-muted mt-2">{page.year}</p>
      </div>
      <button
        id={`close-${slug}`}
        aria-label="Close modal"
        class="text-3xl leading-none text-muted hover:text-ink transition"
      >
        &times;
      </button>
    </header>

    <section class="space-y-10">
      <article>
        <h2 class="text-2xl font-bold text-ink mb-3">The Spark</h2>
        <p class="text-muted leading-relaxed whitespace-pre-line">
          {page.spark}
        </p>
      </article>

      <article>
        <h2 class="text-2xl font-bold text-ink mb-3">What It Does</h2>
        <p class="text-muted leading-relaxed whitespace-pre-line">
          {page.whatItDoes}
        </p>
      </article>

      <article>
        <h2 class="text-2xl font-bold text-ink mb-3">Built With</h2>
        <ul class="flex flex-wrap gap-3">
          {page.tech.map((tool) => (
            <li
              class="px-3 py-1 text-sm bg-paper2 text-ink rounded-full border border-ink"
            >
              {tool}
            </li>
          ))}
        </ul>
      </article>

      {(page.link || page.github) && (
        <article class="space-y-4">
          <h2 class="text-2xl font-bold text-ink mb-3">Links</h2>
          <div class="space-y-2">
            {page.link && (
              <div>
                <span class="text-muted text-sm">Live Project: </span>
                <a
                  href={page.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline break-all"
                >
                  {page.link}
                </a>
              </div>
            )}
            {page.github && (
              <div>
                <span class="text-muted text-sm">Source Code: </span>
                <a
                  href={page.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline break-all"
                >
                  {page.github}
                </a>
              </div>
            )}
          </div>
        </article>
      )}
    </section>

    <footer
      class="border-t border-ink mt-16 pt-6 text-center text-sm text-muted"
    >
      © {new Date().getFullYear()} Zachary
    </footer>
  </div>
</div>
